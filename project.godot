;   param=value ; assign values to parameters

config_version=5

show_default_buttons=false

[application]

config/name="FightLike"
run/main_scene="uid://cujnrkyd7tw8h"
config/features=PackedStringArray("4.7", "Forward Plus")
config/icon="res://icon.svg"

[aseprite_importers]

aseprite_executable_path="C:/Users/andre/Documents/Godot projects/libsprite/libresprite.exe"

[autoload]

Global="*uid://bhs55i387uxya"

[display]

window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

[editor_plugins]

enabled=PackedStringArray("res://addons/AsepriteWizard/plugin.cfg", "res://addons/tool_button/plugin.cfg")

[file_customization]

folder_colors={
"res://Assets/": "green",
"res://Components/": "orange",
"res://Enemies/": "red",
"res://Globals/": "yellow",
"res://Levels/": "pink",
